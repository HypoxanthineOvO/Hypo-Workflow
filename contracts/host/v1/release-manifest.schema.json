{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypo-workflow.dev/contracts/host/v1/release-manifest.schema.json",
  "title": "Hypo-Workflow Host Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "release", "command_manifest", "installed_descriptor", "artifacts"],
  "properties": {
    "schema_version": { "const": "1" },
    "contract_version": { "const": "1" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "command_manifest": { "$ref": "#/$defs/file" },
    "installed_descriptor": { "$ref": "#/$defs/file" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex_plugin", "portable_bundle"],
      "properties": {
        "codex_plugin": { "anyOf": [{ "$ref": "#/$defs/file" }, { "type": "null" }] },
        "portable_bundle": { "anyOf": [{ "$ref": "#/$defs/file" }, { "type": "null" }] }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]*$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
