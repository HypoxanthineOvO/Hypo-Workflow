{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Loading Hypo-Workflow recovery context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking Hypo-Workflow guardrails"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking Hypo-Workflow approval policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording Hypo-Workflow tool evidence"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 120,
            "statusMessage": "Sealing Hypo-Workflow recovery pack"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording Hypo-Workflow compaction outcome"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording Hypo-Workflow worker start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording Hypo-Workflow worker evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording Hypo-Workflow turn boundary"
          }
        ]
      }
    ]
  }
}
