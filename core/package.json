{
  "name": "@hypo-workflow/core",
  "version": "14.0.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Shared deterministic helpers for Hypo-Workflow platform adapters. This package is not a runner.",
  "bin": {
    "hw-core": "./bin/hw-core"
  },
  "scripts": {
    "test": "node ../tests/run_core_tests.mjs --set maintained",
    "test:all": "node ../tests/run_core_tests.mjs --set all",
    "test:quarantine": "node ../tests/run_core_tests.mjs --set quarantined",
    "test:inventory": "node ../tests/run_core_tests.mjs --set all --dry-run",
    "test:scenario-smoke": "python3 ../tests/run_regression.py --set maintained",
    "test:smoke": "npm run test && npm run test:scenario-smoke"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
